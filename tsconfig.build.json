{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // "node", not "bun" -- the published .d.ts must resolve `fetch`,
    // `Request`, `Response` and `process` consistently for whatever
    // runtime consumes it, and @types/bun's own dependency on @types/node
    // (bun-types/index.d.ts references it directly) makes mixing the two
    // here the source of a real global-type conflict; see retry.ts's
    // "double cast" comment for the one place the dev-time (bun) config
    // still hits it.
    "types": ["node"]
  },
  "include": ["src"],
  "exclude": ["test", "src/**/*.test.ts"]
}
