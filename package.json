{
  "name": "pipeline-analytics-sdk-node",
  "version": "1.0.0",
  "description": "Node/TypeScript client for pipeline-analytics's REST API, generated from its OpenAPI spec.",
  "homepage": "https://github.com/alrayyes/pipeline-analytics-sdk-node",
  "bugs": "https://github.com/alrayyes/pipeline-analytics-sdk-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrayyes/pipeline-analytics-sdk-node.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "openapi-typescript openapi/openapi.yaml -o src/generated/schema.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "test:ci": "bun test --coverage --coverage-reporter=lcov --reporter=junit --reporter-outfile=junit.xml",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.1",
    "openapi-typescript": "7.13.0",
    "sort-package-json": "4.0.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  }
}
